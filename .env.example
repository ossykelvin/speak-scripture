# Public application configuration
VITE_APP_NAME="Speak Scripture"
VITE_APP_VERSION="1.1.0"
VITE_APP_URL="http://localhost:8080"
VITE_BIBLE_API_BASE_URL="https://bible-api.com"
VITE_DEFAULT_BIBLE_TRANSLATION="kjv"
VITE_ANALYTICS_ENABLED="true"
VITE_BADGE_THRESHOLDS="1,10,25,50,100,250"
VITE_STORAGE_PROVIDER="localStorage+supabase"
VITE_REFERENCE_FUNCTION_NAME="extract-references"
VITE_REQUEST_TIMEOUT_MS="15000"

# Supabase browser configuration. The anon/publishable key is public by design.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server-only Supabase Edge Function values (set with Supabase CLI, never VITE_*)
# LOVABLE_API_KEY="set-with-supabase-secrets"
# AI_GATEWAY_URL="https://your-provider.example/v1/chat/completions"
# AI_MODEL="provider/model-name"
# ALLOWED_ORIGINS="https://your-production-domain.example,https://localhost,capacitor://localhost,http://localhost"
# Optional migration fallback when the provider key is unavailable
# UPSTREAM_REFERENCE_FUNCTION_URL="https://old-project.supabase.co/functions/v1/extract-references"
# UPSTREAM_REFERENCE_FUNCTION_ANON_KEY="old-project-anon-key"
