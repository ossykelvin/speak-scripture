{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/database-heartbeat",
      "schedule": "0 6 * * *"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|downloads/|favicon.ico|manifest.webmanifest|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
